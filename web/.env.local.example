# 以下变量只在 Next.js 服务端读取，不会打包进浏览器。
BACKEND_API_URL=http://127.0.0.1:8000
# 两个令牌需与后端根目录 .env 保持一致，且不得使用 NEXT_PUBLIC_ 前缀。
ADMIN_TOKEN=replace-with-random-admin-token
OPERATOR_TOKEN=replace-with-different-random-operator-token
WORKBENCH_ADMIN_USERNAME=admin
WORKBENCH_ADMIN_PASSWORD=replace-with-strong-admin-password
WORKBENCH_OPERATOR_USERNAME=operator
WORKBENCH_OPERATOR_PASSWORD=replace-with-strong-operator-password
WORKBENCH_SESSION_SECRET=replace-with-at-least-32-random-characters
WORKBENCH_COOKIE_SECURE=false
