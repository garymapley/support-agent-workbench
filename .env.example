# 在阿里云百炼控制台创建 API Key，再将本文件复制为 .env
DASHSCOPE_API_KEY=sk-your-key-here

# 默认使用百炼 OpenAI 兼容接口。有业务空间专属域名时可替换。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Agent 对话模型
CHAT_MODEL=deepseek-v4.1-flash

# RAG 向量化模型（接入 Qdrant 时使用）
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024

# 业务数据库
DATABASE_URL=sqlite:///./data/app.db

# 本地开发使用 QDRANT_PATH。切换到 Docker/云端时填写 QDRANT_URL。
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=support_policies

# LangGraph 人工审批暂停/恢复状态
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db
LANGGRAPH_STRICT_MSGPACK=true

# 外部服务可靠性：总尝试次数包含首次调用
MODEL_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=20
QDRANT_TIMEOUT_SECONDS=10
EXTERNAL_READ_ATTEMPTS=3

# 可选：按百炼控制台当前价格填写，用于估算每次调用成本。
CHAT_INPUT_COST_PER_MILLION_CNY=0
CHAT_OUTPUT_COST_PER_MILLION_CNY=0
LOG_PATH=./logs/agent.jsonl

